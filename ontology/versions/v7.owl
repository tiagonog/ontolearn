    <!-- http://www.ontolearn.com/ontologia#competenciasEnvolvidas -->

    <owl:ObjectProperty rdf:about="http://www.ontolearn.com/ontologia#competenciasEnvolvidas">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Milestone_de_Aprendizagem"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Trajetórias_de_Aprendizagem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Competência"/>
    </owl:ObjectProperty>
    


