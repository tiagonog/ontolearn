    <!-- http://www.ontolearn.com/ontologia#data -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#data">
        <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Milestone_de_Aprendizagem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#descricao -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#descricao">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Atitude"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Avaliação"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Competência"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Conhecimento"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Curso"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Habilidade"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Milestone_de_Aprendizagem"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Níveis_de_Proficiência"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


