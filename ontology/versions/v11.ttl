@prefix : <http://www.ontolearn.com/ontologia#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.ontolearn.com/ontologia#> .

<http://www.ontolearn.com/ontologia> rdf:type owl:Ontology ;
                                      dcterms:description "Ontologia para análise de aprendizagem baseada em competências."@pt ;
                                      dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
                                      dcterms:title "Ontologia OntoLearn"@pt ;
                                      rdfs:comment "Ontologia OntoLearn - Versão Final (Com Licença). Correção de P04, P08, P11, P13, P20 e P41."@pt ;
                                      rdfs:label "OntoLearn"@pt .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontolearn.com/ontologia#abordaCompetencia
:abordaCompetencia rdf:type owl:ObjectProperty ;
                   owl:inverseOf :ehAbordadaPor ;
                   rdfs:domain :RecursoDeAprendizagem ;
                   rdfs:range :Competencia ;
                   rdfs:comment "Relaciona um recurso educacional à competência que ele visa desenvolver."@pt ;
                   rdfs:label "aborda competência"@pt .


###  http://www.ontolearn.com/ontologia#adquiridaPor
:adquiridaPor rdf:type owl:ObjectProperty ;
              owl:inverseOf :conquistasAdquiridas ;
              rdfs:domain :MilestoneDeAprendizagem ;
              rdfs:range :Aprendiz ;
              rdfs:comment "Aprendiz que adquiriu esta conquista."@pt ;
              rdfs:label "adquirida por"@pt .


###  http://www.ontolearn.com/ontologia#aplicadaNoCurso
:aplicadaNoCurso rdf:type owl:ObjectProperty ;
                 owl:inverseOf :avaliacoesAplicadas ;
                 rdfs:domain :Avaliacao ;
                 rdfs:range :Curso ;
                 rdfs:comment "Curso ao qual a avaliação pertence."@pt ;
                 rdfs:label "aplicada no curso"@pt .


###  http://www.ontolearn.com/ontologia#aprendizAvaliado
:aprendizAvaliado rdf:type owl:ObjectProperty ;
                  owl:inverseOf :teveDesempenhoAvaliado ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain :DesempenhoDoAprendiz ;
                  rdfs:range :Aprendiz ;
                  rdfs:comment "Indica o aprendiz associado a este registro de desempenho."@pt ;
                  rdfs:label "aprendiz avaliado"@pt .


###  http://www.ontolearn.com/ontologia#aprendizesInscritos
:aprendizesInscritos rdf:type owl:ObjectProperty ;
                     owl:inverseOf :estaInscritoEm ;
                     rdfs:domain :Curso ;
                     rdfs:range :Aprendiz ;
                     rdfs:comment "Lista os alunos matriculados no curso."@pt ;
                     rdfs:label "aprendizes inscritos"@pt .


###  http://www.ontolearn.com/ontologia#avaliaDesempenho
:avaliaDesempenho rdf:type owl:ObjectProperty ;
                  owl:inverseOf :temDesempenhoAvaliadoPor ;
                  rdfs:domain :Instrutor ;
                  rdfs:range :DesempenhoDoAprendiz ;
                  rdfs:comment "Indica que o instrutor realizou a avaliação."@pt ;
                  rdfs:label "avalia desempenho"@pt .


###  http://www.ontolearn.com/ontologia#avaliacoesAplicadas
:avaliacoesAplicadas rdf:type owl:ObjectProperty ;
                     rdfs:domain :Curso ;
                     rdfs:range :Avaliacao ;
                     rdfs:comment "Avaliações que compõem o curso."@pt ;
                     rdfs:label "avaliações aplicadas"@pt .


###  http://www.ontolearn.com/ontologia#avaliadaPelaQuestao
:avaliadaPelaQuestao rdf:type owl:ObjectProperty ;
                     owl:inverseOf :competenciasAvaliadas ;
                     rdfs:domain :Competencia ;
                     rdfs:range :Questao ;
                     rdfs:comment "Questões usadas para avaliar a competência."@pt ;
                     rdfs:label "avaliada pela questão"@pt .


###  http://www.ontolearn.com/ontologia#competenciaRelacionada
:competenciaRelacionada rdf:type owl:ObjectProperty ;
                        owl:inverseOf :temQuestaoRelacionada ;
                        rdfs:domain :Questao ;
                        rdfs:range :Competencia ;
                        rdfs:comment "Associa uma questão à competência abordada."@pt ;
                        rdfs:label "competência relacionada"@pt .


###  http://www.ontolearn.com/ontologia#competenciasAvaliadas
:competenciasAvaliadas rdf:type owl:ObjectProperty ;
                       rdfs:domain :Questao ;
                       rdfs:range :Competencia ;
                       rdfs:comment "Competências medidas por esta questão."@pt ;
                       rdfs:label "competências avaliadas"@pt .


###  http://www.ontolearn.com/ontologia#competenciasDoDesempenho
:competenciasDoDesempenho rdf:type owl:ObjectProperty ;
                          owl:inverseOf :desempenhoCompetencias ;
                          rdfs:domain :DesempenhoDoAprendiz ;
                          rdfs:range :Aprendiz ;
                          rdfs:comment "Relaciona o registro de desempenho ao aprendiz."@pt ;
                          rdfs:label "competências do desempenho"@pt .


###  http://www.ontolearn.com/ontologia#competenciasEnvolvidas
:competenciasEnvolvidas rdf:type owl:ObjectProperty ;
                        owl:inverseOf :ehEnvolvidaEm ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :MilestoneDeAprendizagem
                                                    :TrajetoriasDeAprendizagem
                                                  )
                                    ] ;
                        rdfs:range :Competencia ;
                        rdfs:comment "Competências trabalhadas em milestones ou trajetórias."@pt ;
                        rdfs:label "competências envolvidas"@pt .


###  http://www.ontolearn.com/ontologia#compoeAtitudeEm
:compoeAtitudeEm rdf:type owl:ObjectProperty ;
                 owl:inverseOf :ehCompostoDeAtitude ;
                 rdfs:domain :Atitude ;
                 rdfs:range :Competencia ;
                 rdfs:comment "Competência da qual a atitude faz parte."@pt ;
                 rdfs:label "compõe (atitude)"@pt .


###  http://www.ontolearn.com/ontologia#compoeConhecimentoEm
:compoeConhecimentoEm rdf:type owl:ObjectProperty ;
                      owl:inverseOf :ehCompostoDeConhecimento ;
                      rdfs:domain :Conhecimento ;
                      rdfs:range :Competencia ;
                      rdfs:comment "Competência da qual o conhecimento faz parte."@pt ;
                      rdfs:label "compõe (conhecimento)"@pt .


###  http://www.ontolearn.com/ontologia#compoeHabilidadeEm
:compoeHabilidadeEm rdf:type owl:ObjectProperty ;
                    owl:inverseOf :ehCompostoDeHabilidade ;
                    rdfs:domain :Habilidade ;
                    rdfs:range :Competencia ;
                    rdfs:comment "Competência da qual a habilidade faz parte."@pt ;
                    rdfs:label "compõe (habilidade)"@pt .


###  http://www.ontolearn.com/ontologia#conquistasAdquiridas
:conquistasAdquiridas rdf:type owl:ObjectProperty ;
                      rdfs:domain :Aprendiz ;
                      rdfs:range :MilestoneDeAprendizagem ;
                      rdfs:comment "Marcos alcançados pelo estudante."@pt ;
                      rdfs:label "conquistas adquiridas"@pt .


###  http://www.ontolearn.com/ontologia#desempenhoCompetencias
:desempenhoCompetencias rdf:type owl:ObjectProperty ;
                        rdfs:domain :Aprendiz ;
                        rdfs:range :DesempenhoDoAprendiz ;
                        rdfs:comment "Relaciona o aprendiz aos registros de seu desempenho."@pt ;
                        rdfs:label "desempenho em competências"@pt .


###  http://www.ontolearn.com/ontologia#ehAbordadaPor
:ehAbordadaPor rdf:type owl:ObjectProperty ;
               rdfs:domain :Competencia ;
               rdfs:range :RecursoDeAprendizagem ;
               rdfs:comment "Indica quais recursos educacionais cobrem esta competência."@pt ;
               rdfs:label "é abordada por"@pt .


###  http://www.ontolearn.com/ontologia#ehCompostoDeAtitude
:ehCompostoDeAtitude rdf:type owl:ObjectProperty ;
                     rdfs:domain :Competencia ;
                     rdfs:range :Atitude ;
                     rdfs:comment "Atitudes que compõem a competência."@pt ;
                     rdfs:label "é composto de atitude"@pt .


###  http://www.ontolearn.com/ontologia#ehCompostoDeConhecimento
:ehCompostoDeConhecimento rdf:type owl:ObjectProperty ;
                          rdfs:domain :Competencia ;
                          rdfs:range :Conhecimento ;
                          rdfs:comment "Conhecimentos teóricos que compõem a competência."@pt ;
                          rdfs:label "é composto de conhecimento"@pt .


###  http://www.ontolearn.com/ontologia#ehCompostoDeHabilidade
:ehCompostoDeHabilidade rdf:type owl:ObjectProperty ;
                        rdfs:domain :Competencia ;
                        rdfs:range :Habilidade ;
                        rdfs:comment "Habilidades práticas que compõem a competência."@pt ;
                        rdfs:label "é composto de habilidade"@pt .


###  http://www.ontolearn.com/ontologia#ehEnvolvidaEm
:ehEnvolvidaEm rdf:type owl:ObjectProperty ;
               rdfs:domain :Competencia ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :MilestoneDeAprendizagem
                                          :TrajetoriasDeAprendizagem
                                        )
                          ] ;
               rdfs:comment "Milestones ou trajetórias que envolvem a competência."@pt ;
               rdfs:label "é envolvida em"@pt .


###  http://www.ontolearn.com/ontologia#ehExigidoPor
:ehExigidoPor rdf:type owl:ObjectProperty ;
              owl:inverseOf :exigeNivel ;
              rdfs:domain :NiveisDeProficiencia ;
              rdfs:range :Questao ;
              rdfs:comment "Questões que exigem este nível."@pt ;
              rdfs:label "é exigido por"@pt .


###  http://www.ontolearn.com/ontologia#ehRequeridaPor
:ehRequeridaPor rdf:type owl:ObjectProperty ;
                owl:inverseOf :requer ;
                rdf:type owl:TransitiveProperty ;
                rdfs:domain :Competencia ;
                rdfs:range :Competencia ;
                rdfs:comment "Competências que exigem esta como pré-requisito."@pt ;
                rdfs:label "é requerida por"@pt .


###  http://www.ontolearn.com/ontologia#ehResponsavelPor
:ehResponsavelPor rdf:type owl:ObjectProperty ;
                  owl:inverseOf :instrutoresResponsaveis ;
                  rdfs:domain :Instrutor ;
                  rdfs:range :Curso ;
                  rdfs:comment "Cursos coordenados pelo instrutor."@pt ;
                  rdfs:label "é responsável por"@pt .


###  http://www.ontolearn.com/ontologia#elaboraAvaliacoes
:elaboraAvaliacoes rdf:type owl:ObjectProperty ;
                   owl:inverseOf :elaboradaPor ;
                   rdfs:domain :Instrutor ;
                   rdfs:range :Avaliacao ;
                   rdfs:comment "Indica que o instrutor criou a avaliação."@pt ;
                   rdfs:label "elabora avaliações"@pt .


###  http://www.ontolearn.com/ontologia#elaboradaPor
:elaboradaPor rdf:type owl:ObjectProperty ;
              rdfs:domain :Avaliacao ;
              rdfs:range :Instrutor ;
              rdfs:comment "Instrutor responsável pela criação."@pt ;
              rdfs:label "elaborada por"@pt .


###  http://www.ontolearn.com/ontologia#estaInscritoEm
:estaInscritoEm rdf:type owl:ObjectProperty ;
                rdfs:domain :Aprendiz ;
                rdfs:range :Curso ;
                rdfs:comment "Cursos nos quais o aprendiz está matriculado."@pt ;
                rdfs:label "está inscrito em"@pt .


###  http://www.ontolearn.com/ontologia#exigeNivel
:exigeNivel rdf:type owl:ObjectProperty ;
            rdfs:domain :Questao ;
            rdfs:range :NiveisDeProficiencia ;
            rdfs:comment "Nível de proficiência necessário."@pt ;
            rdfs:label "exige nível"@pt .


###  http://www.ontolearn.com/ontologia#fazParteDaAvaliacao
:fazParteDaAvaliacao rdf:type owl:ObjectProperty ;
                     owl:inverseOf :questoesIncluidas ;
                     rdfs:domain :Questao ;
                     rdfs:range :Avaliacao ;
                     rdfs:comment "Indica a qual avaliação a questão pertence."@pt ;
                     rdfs:label "faz parte da avaliação"@pt .


###  http://www.ontolearn.com/ontologia#foiAtingidaEm
:foiAtingidaEm rdf:type owl:ObjectProperty ;
               owl:inverseOf :proficienciaAtingida ;
               rdfs:domain :NiveisDeProficiencia ;
               rdfs:range :DesempenhoDoAprendiz ;
               rdfs:comment "Registros onde este nível foi atingido."@pt ;
               rdfs:label "foi atingida em"@pt .


###  http://www.ontolearn.com/ontologia#historicoAprendizagem
:historicoAprendizagem rdf:type owl:ObjectProperty ;
                       owl:inverseOf :parteDoHistoricoDe ;
                       rdfs:domain :Aprendiz ;
                       rdfs:range :RecursoDeAprendizagem ;
                       rdfs:comment "Recursos consumidos pelo aprendiz."@pt ;
                       rdfs:label "histórico de aprendizagem"@pt .


###  http://www.ontolearn.com/ontologia#insereRecursos
:insereRecursos rdf:type owl:ObjectProperty ;
                owl:inverseOf :inseridoPor ;
                rdfs:domain :Instrutor ;
                rdfs:range :RecursoDeAprendizagem ;
                rdfs:comment "Indica que o instrutor disponibilizou um recurso."@pt ;
                rdfs:label "insere recursos"@pt .


###  http://www.ontolearn.com/ontologia#inseridoPor
:inseridoPor rdf:type owl:ObjectProperty ;
             rdfs:domain :RecursoDeAprendizagem ;
             rdfs:range :Instrutor ;
             rdfs:comment "Instrutor que inseriu o recurso."@pt ;
             rdfs:label "inserido por"@pt .


###  http://www.ontolearn.com/ontologia#instrutoresResponsaveis
:instrutoresResponsaveis rdf:type owl:ObjectProperty ;
                         rdfs:domain :Curso ;
                         rdfs:range :Instrutor ;
                         rdfs:comment "Instrutores que ministram o curso."@pt ;
                         rdfs:label "instrutores responsáveis"@pt .


###  http://www.ontolearn.com/ontologia#parteDoHistoricoDe
:parteDoHistoricoDe rdf:type owl:ObjectProperty ;
                    rdfs:domain :RecursoDeAprendizagem ;
                    rdfs:range :Aprendiz ;
                    rdfs:comment "Aprendiz cujo histórico contém este recurso."@pt ;
                    rdfs:label "parte do histórico de"@pt .


###  http://www.ontolearn.com/ontologia#proficienciaAtingida
:proficienciaAtingida rdf:type owl:ObjectProperty ;
                      rdfs:domain :DesempenhoDoAprendiz ;
                      rdfs:range :NiveisDeProficiencia ;
                      rdfs:comment "Nível de proficiência demonstrado."@pt ;
                      rdfs:label "proficiência atingida"@pt .


###  http://www.ontolearn.com/ontologia#questaoRespondida
:questaoRespondida rdf:type owl:ObjectProperty ;
                   owl:inverseOf :teveRespostaEm ;
                   rdfs:domain :DesempenhoDoAprendiz ;
                   rdfs:range :Questao ;
                   rdfs:comment "Questão à qual o desempenho se refere."@pt ;
                   rdfs:label "questão respondida"@pt .


###  http://www.ontolearn.com/ontologia#questoesIncluidas
:questoesIncluidas rdf:type owl:ObjectProperty ;
                   rdfs:domain :Avaliacao ;
                   rdfs:range :Questao ;
                   rdfs:comment "Questões que compõem a avaliação."@pt ;
                   rdfs:label "questões incluídas"@pt .


###  http://www.ontolearn.com/ontologia#realizadaPor
:realizadaPor rdf:type owl:ObjectProperty ;
              owl:inverseOf :trajetoriasRealizadas ;
              rdfs:domain :TrajetoriasDeAprendizagem ;
              rdfs:range :Aprendiz ;
              rdfs:comment "Aprendiz que realizou a trajetória."@pt ;
              rdfs:label "realizada por"@pt .


###  http://www.ontolearn.com/ontologia#recursosUtilizados
:recursosUtilizados rdf:type owl:ObjectProperty ;
                    owl:inverseOf :utilizadoEm ;
                    rdfs:domain :Curso ;
                    rdfs:range :RecursoDeAprendizagem ;
                    rdfs:comment "Recursos didáticos usados no curso."@pt ;
                    rdfs:label "recursos utilizados"@pt .


###  http://www.ontolearn.com/ontologia#requer
:requer rdf:type owl:ObjectProperty ,
                 owl:TransitiveProperty ;
        rdfs:domain :Competencia ;
        rdfs:range :Competencia ;
        rdfs:comment "Prerrequisitos entre competências."@pt ;
        rdfs:label "requer"@pt .


###  http://www.ontolearn.com/ontologia#temDesempenhoAvaliadoPor
:temDesempenhoAvaliadoPor rdf:type owl:ObjectProperty ;
                          rdfs:domain :DesempenhoDoAprendiz ;
                          rdfs:range :Instrutor ;
                          rdfs:comment "Instrutor responsável pela avaliação."@pt ;
                          rdfs:label "tem desempenho avaliado por"@pt .


###  http://www.ontolearn.com/ontologia#temQuestaoRelacionada
:temQuestaoRelacionada rdf:type owl:ObjectProperty ;
                       rdfs:domain :Competencia ;
                       rdfs:range :Questao ;
                       rdfs:comment "Questões relacionadas a esta competência."@pt ;
                       rdfs:label "tem questão relacionada"@pt .


###  http://www.ontolearn.com/ontologia#teveDesempenhoAvaliado
:teveDesempenhoAvaliado rdf:type owl:ObjectProperty ;
                        rdfs:domain :Aprendiz ;
                        rdfs:range :DesempenhoDoAprendiz ;
                        rdfs:comment "Aponta para os registros de desempenho do aprendiz."@pt ;
                        rdfs:label "teve desempenho avaliado"@pt .


###  http://www.ontolearn.com/ontologia#teveRespostaEm
:teveRespostaEm rdf:type owl:ObjectProperty ;
                rdfs:domain :Questao ;
                rdfs:range :DesempenhoDoAprendiz ;
                rdfs:comment "Desempenhos que respondem a esta questão."@pt ;
                rdfs:label "teve resposta em"@pt .


###  http://www.ontolearn.com/ontologia#trajetoriasRealizadas
:trajetoriasRealizadas rdf:type owl:ObjectProperty ;
                       rdfs:domain :Aprendiz ;
                       rdfs:range :TrajetoriasDeAprendizagem ;
                       rdfs:comment "Caminhos de aprendizagem seguidos pelo aluno."@pt ;
                       rdfs:label "trajetórias realizadas"@pt .


###  http://www.ontolearn.com/ontologia#utilizadoEm
:utilizadoEm rdf:type owl:ObjectProperty ;
             rdfs:domain :RecursoDeAprendizagem ;
             rdfs:range :Curso ;
             rdfs:comment "Cursos onde o recurso é utilizado."@pt ;
             rdfs:label "utilizado em"@pt .


#################################################################
#    Data properties
#################################################################

###  http://www.ontolearn.com/ontologia#alternativas
:alternativas rdf:type owl:DatatypeProperty ;
              rdfs:domain :Questao ;
              rdfs:range xsd:string ;
              rdfs:comment "Opções de resposta."@pt ;
              rdfs:label "alternativas"@pt .


###  http://www.ontolearn.com/ontologia#area
:area rdf:type owl:DatatypeProperty ;
      rdfs:domain :Competencia ;
      rdfs:range xsd:string ;
      rdfs:comment "Área de conhecimento."@pt ;
      rdfs:label "área"@pt .


###  http://www.ontolearn.com/ontologia#data
:data rdf:type owl:DatatypeProperty ;
      rdfs:domain :MilestoneDeAprendizagem ;
      rdfs:range xsd:dateTime ;
      rdfs:comment "Data do evento."@pt ;
      rdfs:label "data"@pt .


###  http://www.ontolearn.com/ontologia#descricao
:descricao rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Avaliacao
                                       :Competencia
                                       :Conhecimento
                                       :Curso
                                       :Habilidade
                                       :MilestoneDeAprendizagem
                                       :RecursoDeAprendizagem
                                     )
                       ] ;
           rdfs:range xsd:string ;
           rdfs:comment "Texto descritivo."@pt ;
           rdfs:label "descrição"@pt .


###  http://www.ontolearn.com/ontologia#enunciado
:enunciado rdf:type owl:DatatypeProperty ;
           rdfs:domain :Questao ;
           rdfs:range xsd:string ;
           rdfs:comment "Pergunta da questão."@pt ;
           rdfs:label "enunciado"@pt .


###  http://www.ontolearn.com/ontologia#etapas
:etapas rdf:type owl:DatatypeProperty ;
        rdfs:domain :TrajetoriasDeAprendizagem ;
        rdfs:range xsd:string ;
        rdfs:comment "Etapas da trajetória."@pt ;
        rdfs:label "etapas"@pt .


###  http://www.ontolearn.com/ontologia#idAprendiz
:idAprendiz rdf:type owl:DatatypeProperty ;
            rdfs:domain :Aprendiz ;
            rdfs:range xsd:string ;
            rdfs:comment "Identificador único do aprendiz."@pt ;
            rdfs:label "id do aprendiz"@pt .


###  http://www.ontolearn.com/ontologia#idAtitude
:idAtitude rdf:type owl:DatatypeProperty ;
           rdfs:domain :Atitude ;
           rdfs:range xsd:string ;
           rdfs:comment "Identificador da atitude."@pt ;
           rdfs:label "id da atitude"@pt .


###  http://www.ontolearn.com/ontologia#idAvaliacao
:idAvaliacao rdf:type owl:DatatypeProperty ;
             rdfs:domain :Avaliacao ;
             rdfs:range xsd:string ;
             rdfs:comment "Identificador da avaliação."@pt ;
             rdfs:label "id da avaliação"@pt .


###  http://www.ontolearn.com/ontologia#idCompetencia
:idCompetencia rdf:type owl:DatatypeProperty ;
               rdfs:domain :Competencia ;
               rdfs:range xsd:string ;
               rdfs:comment "Identificador da competência."@pt ;
               rdfs:label "id da competência"@pt .


###  http://www.ontolearn.com/ontologia#idConhecimento
:idConhecimento rdf:type owl:DatatypeProperty ;
                rdfs:domain :Conhecimento ;
                rdfs:range xsd:string ;
                rdfs:comment "Identificador do conhecimento."@pt ;
                rdfs:label "id do conhecimento"@pt .


###  http://www.ontolearn.com/ontologia#idCurso
:idCurso rdf:type owl:DatatypeProperty ;
         rdfs:domain :Curso ;
         rdfs:range xsd:string ;
         rdfs:comment "Identificador do curso."@pt ;
         rdfs:label "id do curso"@pt .


###  http://www.ontolearn.com/ontologia#idDesempenho
:idDesempenho rdf:type owl:DatatypeProperty ;
              rdfs:domain :DesempenhoDoAprendiz ;
              rdfs:range xsd:string ;
              rdfs:comment "Identificador do desempenho."@pt ;
              rdfs:label "id do desempenho"@pt .


###  http://www.ontolearn.com/ontologia#idHabilidade
:idHabilidade rdf:type owl:DatatypeProperty ;
              rdfs:domain :Habilidade ;
              rdfs:range xsd:string ;
              rdfs:comment "Identificador da habilidade."@pt ;
              rdfs:label "id da habilidade"@pt .


###  http://www.ontolearn.com/ontologia#idInstrutor
:idInstrutor rdf:type owl:DatatypeProperty ;
             rdfs:domain :Instrutor ;
             rdfs:range xsd:string ;
             rdfs:comment "Identificador do instrutor."@pt ;
             rdfs:label "id do instrutor"@pt .


###  http://www.ontolearn.com/ontologia#idMilestone
:idMilestone rdf:type owl:DatatypeProperty ;
             rdfs:domain :MilestoneDeAprendizagem ;
             rdfs:range xsd:string ;
             rdfs:comment "Identificador do milestone."@pt ;
             rdfs:label "id do milestone"@pt .


###  http://www.ontolearn.com/ontologia#idNivel
:idNivel rdf:type owl:DatatypeProperty ;
         rdfs:domain :NiveisDeProficiencia ;
         rdfs:range xsd:string ;
         rdfs:comment "Identificador do nível de proficiência."@pt ;
         rdfs:label "id do nível"@pt .


###  http://www.ontolearn.com/ontologia#idQuestao
:idQuestao rdf:type owl:DatatypeProperty ;
           rdfs:domain :Questao ;
           rdfs:range xsd:string ;
           rdfs:comment "Identificador da questão."@pt ;
           rdfs:label "id da questão"@pt .


###  http://www.ontolearn.com/ontologia#idRecurso
