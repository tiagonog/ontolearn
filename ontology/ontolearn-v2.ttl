@prefix : <http://www.ontolearn.com/ontologia#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

<http://www.ontolearn.com/ontologia> a owl:Ontology ;
    rdfs:label "OntoLearn"@pt ;
    dcterms:description "Ontologia para análise de aprendizagem baseada em competências."@pt ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Ontologia OntoLearn"@pt ;
    rdfs:comment "OntoLearn v2.0 - axiomatic completion of v1.0: Subjetiva taxonomic repair; KSA + top-level disjointness; existential participation constraints; KSA role hierarchy; functional proficienciaAtingida. Generated by build_v2.py (released with the article)."@en,
        "Ontologia OntoLearn - Versão Final (Com Licença). Correção de P04, P08, P11, P13, P20 e P41."@pt ;
    owl:versionInfo "2.0" .

:Analisar a owl:Class ;
    rdfs:label "Analisar"@pt ;
    rdfs:comment "Nível Analisar."@pt ;
    rdfs:subClassOf :NiveisDeProficiencia .

:AvaliarBloom a owl:Class ;
    rdfs:label "Avaliar (Bloom)"@pt ;
    rdfs:comment "Nível Avaliar."@pt ;
    rdfs:subClassOf :NiveisDeProficiencia .

:Criar a owl:Class ;
    rdfs:label "Criar"@pt ;
    rdfs:comment "Nível Criar."@pt ;
    rdfs:subClassOf :NiveisDeProficiencia .

:Didatico a owl:Class ;
    rdfs:label "Didático"@pt ;
    rdfs:comment "Material didático."@pt ;
    rdfs:subClassOf :RecursoDeAprendizagem .

:Entender a owl:Class ;
    rdfs:label "Entender"@pt ;
    rdfs:comment "Nível Entender."@pt ;
    rdfs:subClassOf :NiveisDeProficiencia .

:Interativo a owl:Class ;
    rdfs:label "Interativo"@pt ;
    rdfs:comment "Material interativo."@pt ;
    rdfs:subClassOf :RecursoDeAprendizagem .

:QUEST-0001 a :Objetiva,
        owl:NamedIndividual ;
    :competenciasAvaliadas :COMP-0001 ;
    :enunciado "O que é um objeto em POO?" ;
    :fazParteDaAvaliacao :AVAL-0002 ;
    :idQuestao "QUEST-0001" .

:adquiridaPor a owl:ObjectProperty ;
    rdfs:label "adquirida por"@pt ;
    rdfs:comment "Aprendiz que adquiriu esta conquista."@pt ;
    rdfs:domain :MilestoneDeAprendizagem ;
    rdfs:range :Aprendiz ;
    owl:inverseOf :conquistasAdquiridas .

:alternativas a owl:DatatypeProperty ;
    rdfs:label "alternativas"@pt ;
    rdfs:comment "Opções de resposta."@pt ;
    rdfs:domain :Questao ;
    rdfs:range xsd:string .

:aplicadaNoCurso a owl:ObjectProperty ;
    rdfs:label "aplicada no curso"@pt ;
    rdfs:comment "Curso ao qual a avaliação pertence."@pt ;
    rdfs:domain :Avaliacao ;
    rdfs:range :Curso ;
    owl:inverseOf :avaliacoesAplicadas .

:aprendizAvaliado a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "aprendiz avaliado"@pt ;
    rdfs:comment "Indica o aprendiz associado a este registro de desempenho."@pt ;
    rdfs:domain :DesempenhoDoAprendiz ;
    rdfs:range :Aprendiz ;
    owl:inverseOf :teveDesempenhoAvaliado .

:aprendizesInscritos a owl:ObjectProperty ;
    rdfs:label "aprendizes inscritos"@pt ;
    rdfs:comment "Lista os alunos matriculados no curso."@pt ;
    rdfs:domain :Curso ;
    rdfs:range :Aprendiz ;
    owl:inverseOf :estaInscritoEm .

:area a owl:DatatypeProperty ;
    rdfs:label "área"@pt ;
    rdfs:comment "Área de conhecimento."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range xsd:string .

:avaliaDesempenho a owl:ObjectProperty ;
    rdfs:label "avalia desempenho"@pt ;
    rdfs:comment "Indica que o instrutor realizou a avaliação."@pt ;
    rdfs:domain :Instrutor ;
    rdfs:range :DesempenhoDoAprendiz ;
    owl:inverseOf :temDesempenhoAvaliadoPor .

:avaliadaPelaQuestao a owl:ObjectProperty ;
    rdfs:label "avaliada pela questão"@pt ;
    rdfs:comment "Questões usadas para avaliar a competência."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range :Questao ;
    owl:inverseOf :competenciasAvaliadas .

:competenciaRelacionada a owl:ObjectProperty ;
    rdfs:label "competência relacionada"@pt ;
    rdfs:comment "Associa uma questão à competência abordada."@pt ;
    rdfs:domain :Questao ;
    rdfs:range :Competencia ;
    owl:inverseOf :temQuestaoRelacionada .

:competenciasDoDesempenho a owl:ObjectProperty ;
    rdfs:label "competências do desempenho"@pt ;
    rdfs:comment "Relaciona o registro de desempenho ao aprendiz."@pt ;
    rdfs:domain :DesempenhoDoAprendiz ;
    rdfs:range :Aprendiz ;
    owl:inverseOf :desempenhoCompetencias .

:competenciasEnvolvidas a owl:ObjectProperty ;
    rdfs:label "competências envolvidas"@pt ;
    rdfs:comment "Competências trabalhadas em milestones ou trajetórias."@pt ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :MilestoneDeAprendizagem :TrajetoriasDeAprendizagem ) ] ;
    rdfs:range :Competencia ;
    owl:inverseOf :ehEnvolvidaEm .

:compoeAtitudeEm a owl:ObjectProperty ;
    rdfs:label "compõe (atitude)"@pt ;
    rdfs:comment "Competência da qual a atitude faz parte."@pt ;
    rdfs:domain :Atitude ;
    rdfs:range :Competencia ;
    rdfs:subPropertyOf :ehComponenteKSADe ;
    owl:inverseOf :ehCompostoDeAtitude .

:compoeConhecimentoEm a owl:ObjectProperty ;
    rdfs:label "compõe (conhecimento)"@pt ;
    rdfs:comment "Competência da qual o conhecimento faz parte."@pt ;
    rdfs:domain :Conhecimento ;
    rdfs:range :Competencia ;
    rdfs:subPropertyOf :ehComponenteKSADe ;
    owl:inverseOf :ehCompostoDeConhecimento .

:compoeHabilidadeEm a owl:ObjectProperty ;
    rdfs:label "compõe (habilidade)"@pt ;
    rdfs:comment "Competência da qual a habilidade faz parte."@pt ;
    rdfs:domain :Habilidade ;
    rdfs:range :Competencia ;
    rdfs:subPropertyOf :ehComponenteKSADe ;
    owl:inverseOf :ehCompostoDeHabilidade .

:data a owl:DatatypeProperty ;
    rdfs:label "data"@pt ;
    rdfs:comment "Data do evento."@pt ;
    rdfs:domain :MilestoneDeAprendizagem ;
    rdfs:range xsd:dateTime .

:descricao a owl:DatatypeProperty ;
    rdfs:label "descrição"@pt ;
    rdfs:comment "Texto descritivo."@pt ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Avaliacao :Competencia :Conhecimento :Curso :Habilidade :MilestoneDeAprendizagem :RecursoDeAprendizagem :NiveisDeProficiencia ) ] ;
    rdfs:range xsd:string .

:ehExigidoPor a owl:ObjectProperty ;
    rdfs:label "é exigido por"@pt ;
    rdfs:comment "Questões que exigem este nível."@pt ;
    rdfs:domain :NiveisDeProficiencia ;
    rdfs:range :Questao ;
    owl:inverseOf :exigeNivel .

:ehRequeridaPor a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "é requerida por"@pt ;
    rdfs:comment "Competências que exigem esta como pré-requisito."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range :Competencia ;
    owl:inverseOf :requer .

:ehResponsavelPor a owl:ObjectProperty ;
    rdfs:label "é responsável por"@pt ;
    rdfs:comment "Cursos coordenados pelo instrutor."@pt ;
    rdfs:domain :Instrutor ;
    rdfs:range :Curso ;
    owl:inverseOf :instrutoresResponsaveis .

:elaboraAvaliacoes a owl:ObjectProperty ;
    rdfs:label "elabora avaliações"@pt ;
    rdfs:comment "Indica que o instrutor criou a avaliação."@pt ;
    rdfs:domain :Instrutor ;
    rdfs:range :Avaliacao ;
    owl:inverseOf :elaboradaPor .

:enunciado a owl:DatatypeProperty ;
    rdfs:label "enunciado"@pt ;
    rdfs:comment "Pergunta da questão."@pt ;
    rdfs:domain :Questao ;
    rdfs:range xsd:string .

:etapas a owl:DatatypeProperty ;
    rdfs:label "etapas"@pt ;
    rdfs:comment "Etapas da trajetória."@pt ;
    rdfs:domain :TrajetoriasDeAprendizagem ;
    rdfs:range xsd:string .

:fazParteDaAvaliacao a owl:ObjectProperty ;
    rdfs:label "faz parte da avaliação"@pt ;
    rdfs:comment "Indica a qual avaliação a questão pertence."@pt ;
    rdfs:domain :Questao ;
    rdfs:range :Avaliacao ;
    owl:inverseOf :questoesIncluidas .

:foiAtingidaEm a owl:ObjectProperty ;
    rdfs:label "foi atingida em"@pt ;
    rdfs:comment "Registros onde este nível foi atingido."@pt ;
    rdfs:domain :NiveisDeProficiencia ;
    rdfs:range :DesempenhoDoAprendiz ;
    owl:inverseOf :proficienciaAtingida .

:historicoAprendizagem a owl:ObjectProperty ;
    rdfs:label "histórico de aprendizagem"@pt ;
    rdfs:comment "Recursos consumidos pelo aprendiz."@pt ;
    rdfs:domain :Aprendiz ;
    rdfs:range :RecursoDeAprendizagem ;
    owl:inverseOf :parteDoHistoricoDe .

:idAprendiz a owl:DatatypeProperty ;
    rdfs:label "id do aprendiz"@pt ;
    rdfs:comment "Identificador único do aprendiz."@pt ;
    rdfs:domain :Aprendiz ;
    rdfs:range xsd:string .

:idAtitude a owl:DatatypeProperty ;
    rdfs:label "id da atitude"@pt ;
    rdfs:comment "Identificador da atitude."@pt ;
    rdfs:domain :Atitude ;
    rdfs:range xsd:string .

:idAvaliacao a owl:DatatypeProperty ;
    rdfs:label "id da avaliação"@pt ;
    rdfs:comment "Identificador da avaliação."@pt ;
    rdfs:domain :Avaliacao ;
    rdfs:range xsd:string .

:idCompetencia a owl:DatatypeProperty ;
    rdfs:label "id da competência"@pt ;
    rdfs:comment "Identificador da competência."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range xsd:string .

:idConhecimento a owl:DatatypeProperty ;
    rdfs:label "id do conhecimento"@pt ;
    rdfs:comment "Identificador do conhecimento."@pt ;
    rdfs:domain :Conhecimento ;
    rdfs:range xsd:string .

:idCurso a owl:DatatypeProperty ;
    rdfs:label "id do curso"@pt ;
    rdfs:comment "Identificador do curso."@pt ;
    rdfs:domain :Curso ;
    rdfs:range xsd:string .

:idDesempenho a owl:DatatypeProperty ;
    rdfs:label "id do desempenho"@pt ;
    rdfs:comment "Identificador do desempenho."@pt ;
    rdfs:domain :DesempenhoDoAprendiz ;
    rdfs:range xsd:string .

:idHabilidade a owl:DatatypeProperty ;
    rdfs:label "id da habilidade"@pt ;
    rdfs:comment "Identificador da habilidade."@pt ;
    rdfs:domain :Habilidade ;
    rdfs:range xsd:string .

:idInstrutor a owl:DatatypeProperty ;
    rdfs:label "id do instrutor"@pt ;
    rdfs:comment "Identificador do instrutor."@pt ;
    rdfs:domain :Instrutor ;
    rdfs:range xsd:string .

:idMilestone a owl:DatatypeProperty ;
    rdfs:label "id do milestone"@pt ;
    rdfs:comment "Identificador do milestone."@pt ;
    rdfs:domain :MilestoneDeAprendizagem ;
    rdfs:range xsd:string .

:idNivel a owl:DatatypeProperty ;
    rdfs:label "id do nível"@pt ;
    rdfs:comment "Identificador do nível de proficiência."@pt ;
    rdfs:domain :NiveisDeProficiencia ;
    rdfs:range xsd:string .

:idQuestao a owl:DatatypeProperty ;
    rdfs:label "id da questão"@pt ;
    rdfs:comment "Identificador da questão."@pt ;
    rdfs:domain :Questao ;
    rdfs:range xsd:string .

:idRecurso a owl:DatatypeProperty ;
    rdfs:label "id do recurso"@pt ;
    rdfs:comment "Identificador do recurso."@pt ;
    rdfs:domain :RecursoDeAprendizagem ;
    rdfs:range xsd:string .

:idTrajetoria a owl:DatatypeProperty ;
    rdfs:label "id da trajetória"@pt ;
    rdfs:comment "Identificador da trajetória."@pt ;
    rdfs:domain :TrajetoriasDeAprendizagem ;
    rdfs:range xsd:string .

:insereRecursos a owl:ObjectProperty ;
    rdfs:label "insere recursos"@pt ;
    rdfs:comment "Indica que o instrutor disponibilizou um recurso."@pt ;
    rdfs:domain :Instrutor ;
    rdfs:range :RecursoDeAprendizagem ;
    owl:inverseOf :inseridoPor .

:nivel a owl:DatatypeProperty ;
    rdfs:label "nível"@pt ;
    rdfs:comment "Nível educacional do curso."@pt ;
    rdfs:domain :Curso ;
    rdfs:range xsd:string .

:nome a owl:DatatypeProperty ;
    rdfs:label "nome"@pt ;
    rdfs:comment "Nome ou designação da entidade."@pt ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Competencia :Curso :RecursoDeAprendizagem :UsuarioDoAva ) ] ;
    rdfs:range xsd:string .

:questaoRespondida a owl:ObjectProperty ;
    rdfs:label "questão respondida"@pt ;
    rdfs:comment "Questão à qual o desempenho se refere."@pt ;
    rdfs:domain :DesempenhoDoAprendiz ;
    rdfs:range :Questao ;
    owl:inverseOf :teveRespostaEm .

:realizadaPor a owl:ObjectProperty ;
    rdfs:label "realizada por"@pt ;
    rdfs:comment "Aprendiz que realizou a trajetória."@pt ;
    rdfs:domain :TrajetoriasDeAprendizagem ;
    rdfs:range :Aprendiz ;
    owl:inverseOf :trajetoriasRealizadas .

:recursosUtilizados a owl:ObjectProperty ;
    rdfs:label "recursos utilizados"@pt ;
    rdfs:comment "Recursos didáticos usados no curso."@pt ;
    rdfs:domain :Curso ;
    rdfs:range :RecursoDeAprendizagem ;
    owl:inverseOf :utilizadoEm .

:respostaAprendiz a owl:DatatypeProperty ;
    rdfs:label "resposta do aprendiz"@pt ;
    rdfs:comment "Resposta fornecida pelo aluno."@pt ;
    rdfs:domain :DesempenhoDoAprendiz ;
    rdfs:range xsd:string .

:respostaCorreta a owl:DatatypeProperty ;
    rdfs:label "resposta correta"@pt ;
    rdfs:comment "Gabarito da questão."@pt ;
    rdfs:domain :Questao ;
    rdfs:range xsd:string .

:tipo a owl:DatatypeProperty ;
    rdfs:label "tipo"@pt ;
    rdfs:comment "Categoria ou tipo do objeto."@pt ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Avaliacao :MilestoneDeAprendizagem :Questao :RecursoDeAprendizagem ) ] ;
    rdfs:range xsd:string .

:titulo a owl:DatatypeProperty ;
    rdfs:label "título"@pt ;
    rdfs:comment "Título do curso."@pt ;
    rdfs:domain :Curso ;
    rdfs:range xsd:string .

:url a owl:DatatypeProperty ;
    rdfs:label "URL"@pt ;
    rdfs:comment "Endereço web do recurso."@pt ;
    rdfs:domain :RecursoDeAprendizagem ;
    rdfs:range xsd:anyURI .

:Aplicar a owl:Class ;
    rdfs:label "Aplicar"@pt ;
    rdfs:comment "Nível Aplicar."@pt ;
    rdfs:subClassOf :NiveisDeProficiencia .

:DEMP-0004 a :DesempenhoDoAprendiz,
        owl:NamedIndividual ;
    rdfs:comment "Indivíduo Desempenho 0004"@pt .

:DEMP-0005 a :Formativo,
        owl:NamedIndividual ;
    :aprendizAvaliado :APR-0001 ;
    :idDesempenho "DEMP-0005" ;
    :proficienciaAtingida :NP-Lembrar ;
    :questaoRespondida :QUEST-0005 .

:INST-0001 a :Instrutor,
        owl:NamedIndividual ;
    :avaliaDesempenho :DEMP-0003 ;
    :ehResponsavelPor :CUR-0001 ;
    :elaboraAvaliacoes :AVAL-0002 ;
    :idInstrutor "INST-0001" ;
    :insereRecursos :REC-0004 ;
    :nome "Maria Fernandes" ;
    rdfs:comment "Indivíduo Instrutor 0001"@pt .

:KNOW-001 a :Conhecimento,
        owl:NamedIndividual ;
    :descricao "Saber a definição de superclasse, subclasse e a sintaxe de herança." ;
    :idConhecimento "KNOW-001" ;
    rdfs:comment "Indivíduo Conhecimento 001"@pt .

:Lembrar a owl:Class ;
    rdfs:label "Lembrar"@pt ;
    rdfs:comment "Nível Lembrar."@pt ;
    rdfs:subClassOf :NiveisDeProficiencia .

:MILE-0001 a :MilestoneDeAprendizagem,
        owl:NamedIndividual ;
    :competenciasEnvolvidas :COMP-0001,
        :COMP-0002 ;
    :data "2024-02-20T18:00:00+00:00"^^xsd:dateTime ;
    :descricao "Conclusão do Curso Introdução à Programação com Python" ;
    :idMilestone "MILE-0001" ;
    :tipo "Conclusão de Curso" ;
    rdfs:comment "Indivíduo Milestone 0001"@pt .

:Multimidia a owl:Class ;
    rdfs:label "Multimídia"@pt ;
    rdfs:comment "Material multimídia."@pt ;
    rdfs:subClassOf :RecursoDeAprendizagem .

:NP-Lembrar a :Lembrar,
        owl:NamedIndividual ;
    rdfs:label "Lembrar"@pt ;
    :idNivel "NP-0001-Lembrar" .

:ObjetivasAval a owl:Class ;
    rdfs:label "Avaliação Objetiva"@pt ;
    rdfs:comment "Prova objetiva."@pt ;
    rdfs:subClassOf :Avaliacao .

:QUEST-0005 a :Subjetiva,
        owl:NamedIndividual ;
    :competenciasAvaliadas :COMP-0002 ;
    :enunciado "Explique com suas palavras a vantagem da herança." ;
    :fazParteDaAvaliacao :AVAL-0002 ;
    :idQuestao "QUEST-0005" .

:REC-0002 a :RecursoDeAprendizagem,
        owl:NamedIndividual ;
    :idRecurso "REC-0002" ;
    :url "http://ontolearn.com/aula1-poo"^^xsd:anyURI ;
    rdfs:comment "Indivíduo Recurso 0002"@pt .

:REC-0004 a :Video,
        owl:NamedIndividual ;
    :abordaCompetencia :COMP-0002 ;
    :idRecurso "REC-0004" ;
    :tipo "Vídeo" ;
    :url "http://example.com/heranca-python-video"^^xsd:anyURI ;
    rdfs:comment "Indivíduo Recurso 0004"@pt .

:REC-0005 a :RecursoDeAprendizagem,
        owl:NamedIndividual ;
    :idRecurso "REC-0005" ;
    :url "http://ontolearn.com/exercicios-heranca"^^xsd:anyURI ;
    rdfs:comment "Indivíduo Recurso 0005"@pt .

:SKILL-001 a :Habilidade,
        owl:NamedIndividual ;
    :descricao "Capacidade de implementar uma subclasse que sobrescreve um método da superclasse." ;
    :idHabilidade "SKILL-001" ;
    rdfs:comment "Indivíduo Habilidade 001"@pt .

:Video a owl:Class ;
    rdfs:label "Vídeo"@pt ;
    rdfs:comment "Conteúdo em vídeo."@pt ;
    rdfs:subClassOf :Multimidia .

:abordaCompetencia a owl:ObjectProperty ;
    rdfs:label "aborda competência"@pt ;
    rdfs:comment "Relaciona um recurso educacional à competência que ele visa desenvolver."@pt ;
    rdfs:domain :RecursoDeAprendizagem ;
    rdfs:range :Competencia ;
    owl:inverseOf :ehAbordadaPor .

:avaliacoesAplicadas a owl:ObjectProperty ;
    rdfs:label "avaliações aplicadas"@pt ;
    rdfs:comment "Avaliações que compõem o curso."@pt ;
    rdfs:domain :Curso ;
    rdfs:range :Avaliacao .

:conquistasAdquiridas a owl:ObjectProperty ;
    rdfs:label "conquistas adquiridas"@pt ;
    rdfs:comment "Marcos alcançados pelo estudante."@pt ;
    rdfs:domain :Aprendiz ;
    rdfs:range :MilestoneDeAprendizagem .

:desempenhoCompetencias a owl:ObjectProperty ;
    rdfs:label "desempenho em competências"@pt ;
    rdfs:comment "Relaciona o aprendiz aos registros de seu desempenho."@pt ;
    rdfs:domain :Aprendiz ;
    rdfs:range :DesempenhoDoAprendiz .

:ehAbordadaPor a owl:ObjectProperty ;
    rdfs:label "é abordada por"@pt ;
    rdfs:comment "Indica quais recursos educacionais cobrem esta competência."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range :RecursoDeAprendizagem .

:ehCompostoDeAtitude a owl:ObjectProperty ;
    rdfs:label "é composto de atitude"@pt ;
    rdfs:comment "Atitudes que compõem a competência."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range :Atitude ;
    rdfs:subPropertyOf :temComponenteKSA .

:ehCompostoDeConhecimento a owl:ObjectProperty ;
    rdfs:label "é composto de conhecimento"@pt ;
    rdfs:comment "Conhecimentos teóricos que compõem a competência."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range :Conhecimento ;
    rdfs:subPropertyOf :temComponenteKSA .

:ehCompostoDeHabilidade a owl:ObjectProperty ;
    rdfs:label "é composto de habilidade"@pt ;
    rdfs:comment "Habilidades práticas que compõem a competência."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range :Habilidade ;
    rdfs:subPropertyOf :temComponenteKSA .

:ehEnvolvidaEm a owl:ObjectProperty ;
    rdfs:label "é envolvida em"@pt ;
    rdfs:comment "Milestones ou trajetórias que envolvem a competência."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( :MilestoneDeAprendizagem :TrajetoriasDeAprendizagem ) ] .

:elaboradaPor a owl:ObjectProperty ;
    rdfs:label "elaborada por"@pt ;
    rdfs:comment "Instrutor responsável pela criação."@pt ;
    rdfs:domain :Avaliacao ;
    rdfs:range :Instrutor .

:estaInscritoEm a owl:ObjectProperty ;
    rdfs:label "está inscrito em"@pt ;
    rdfs:comment "Cursos nos quais o aprendiz está matriculado."@pt ;
    rdfs:domain :Aprendiz ;
    rdfs:range :Curso .

:exigeNivel a owl:ObjectProperty ;
    rdfs:label "exige nível"@pt ;
    rdfs:comment "Nível de proficiência necessário."@pt ;
    rdfs:domain :Questao ;
    rdfs:range :NiveisDeProficiencia .

:inseridoPor a owl:ObjectProperty ;
    rdfs:label "inserido por"@pt ;
    rdfs:comment "Instrutor que inseriu o recurso."@pt ;
    rdfs:domain :RecursoDeAprendizagem ;
    rdfs:range :Instrutor .

:instrutoresResponsaveis a owl:ObjectProperty ;
    rdfs:label "instrutores responsáveis"@pt ;
    rdfs:comment "Instrutores que ministram o curso."@pt ;
    rdfs:domain :Curso ;
    rdfs:range :Instrutor .

:parteDoHistoricoDe a owl:ObjectProperty ;
    rdfs:label "parte do histórico de"@pt ;
    rdfs:comment "Aprendiz cujo histórico contém este recurso."@pt ;
    rdfs:domain :RecursoDeAprendizagem ;
    rdfs:range :Aprendiz .

:requer a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "requer"@pt ;
    rdfs:comment "Prerrequisitos entre competências."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range :Competencia .

:temDesempenhoAvaliadoPor a owl:ObjectProperty ;
    rdfs:label "tem desempenho avaliado por"@pt ;
    rdfs:comment "Instrutor responsável pela avaliação."@pt ;
    rdfs:domain :DesempenhoDoAprendiz ;
    rdfs:range :Instrutor .

:temQuestaoRelacionada a owl:ObjectProperty ;
    rdfs:label "tem questão relacionada"@pt ;
    rdfs:comment "Questões relacionadas a esta competência."@pt ;
    rdfs:domain :Competencia ;
    rdfs:range :Questao .

:teveDesempenhoAvaliado a owl:ObjectProperty ;
    rdfs:label "teve desempenho avaliado"@pt ;
    rdfs:comment "Aponta para os registros de desempenho do aprendiz."@pt ;
    rdfs:domain :Aprendiz ;
    rdfs:range :DesempenhoDoAprendiz .

:teveRespostaEm a owl:ObjectProperty ;
    rdfs:label "teve resposta em"@pt ;
    rdfs:comment "Desempenhos que respondem a esta questão."@pt ;
    rdfs:domain :Questao ;
    rdfs:range :DesempenhoDoAprendiz .

:trajetoriasRealizadas a owl:ObjectProperty ;
    rdfs:label "trajetórias realizadas"@pt ;
    rdfs:comment "Caminhos de aprendizagem seguidos pelo aluno."@pt ;
    rdfs:domain :Aprendiz ;
    rdfs:range :TrajetoriasDeAprendizagem .

:utilizadoEm a owl:ObjectProperty ;
    rdfs:label "utilizado em"@pt ;
    rdfs:comment "Cursos onde o recurso é utilizado."@pt ;
    rdfs:domain :RecursoDeAprendizagem ;
    rdfs:range :Curso .

:CUR-0001 a :Curso,
        owl:NamedIndividual ;
    :aprendizesInscritos :APR-0001 ;
    :avaliacoesAplicadas :AVAL-0002 ;
    :descricao "Curso básico para aprender Python." ;
    :idCurso "CUR-0001" ;
    :instrutoresResponsaveis :INST-0001 ;
    :nivel "Educação Terciária de Ciclo Curto" ;
    :titulo "Introdução à Programação com Python" ;
    rdfs:comment "Indivíduo Curso 0001"@pt .

:DEMP-0003 a :Formativo,
        owl:NamedIndividual ;
    :aprendizAvaliado :APR-0001 ;
    :idDesempenho "DEMP-0003" ;
    :proficienciaAtingida :NP-Aplicar ;
    :questaoRespondida :QUEST-0003 ;
    :respostaAprendiz "Permite que uma classe herde atributos e métodos de outra classe" ;
    rdfs:comment "Indivíduo Desempenho 0003"@pt .

:Formativo a owl:Class ;
    rdfs:label "Formativo"@pt ;
    rdfs:comment "Avaliação formativa."@pt ;
    rdfs:subClassOf :DesempenhoDoAprendiz .

:NP-Aplicar a :Aplicar,
        owl:NamedIndividual ;
    rdfs:label "Aplicar"@pt ;
    :descricao "Nível 3 de Bloom: Usar informação em novas situações." ;
    :idNivel "NP-0003-Aplicar" ;
    rdfs:comment "Indivíduo Nível de Proficiência Aplicar"@pt .

:Objetiva a owl:Class ;
    rdfs:label "Objetiva"@pt ;
    rdfs:comment "Questão objetiva."@pt ;
    rdfs:subClassOf :Questao ;
    owl:disjointWith :Subjetiva .

:QUEST-0003 a :Objetiva,
        owl:NamedIndividual ;
    :competenciasAvaliadas :COMP-0002 ;
    :enunciado "Como funciona a herança em Python?" ;
    :exigeNivel :NP-Aplicar ;
    :idQuestao "QUEST-0003" ;
    :respostaCorreta "Permite que uma classe herde atributos e métodos de outra classe" ;
    :tipo "Múltipla Escolha" ;
    rdfs:comment "Indivíduo Questão 0003"@pt .

:Subjetiva a owl:Class ;
    rdfs:subClassOf :Questao .

:competenciasAvaliadas a owl:ObjectProperty ;
    rdfs:label "competências avaliadas"@pt ;
    rdfs:comment "Competências medidas por esta questão."@pt ;
    rdfs:domain :Questao ;
    rdfs:range :Competencia .

:proficienciaAtingida a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "proficiência atingida"@pt ;
    rdfs:comment "Nível de proficiência demonstrado."@pt ;
    rdfs:domain :DesempenhoDoAprendiz ;
    rdfs:range :NiveisDeProficiencia .

:questoesIncluidas a owl:ObjectProperty ;
    rdfs:label "questões incluídas"@pt ;
    rdfs:comment "Questões que compõem a avaliação."@pt ;
    rdfs:domain :Avaliacao ;
    rdfs:range :Questao .

:APR-0001 a :Aprendiz,
        owl:NamedIndividual ;
    :conquistasAdquiridas :MILE-0001 ;
    :desempenhoCompetencias :DEMP-0003,
        :DEMP-0004,
        :DEMP-0005 ;
    :estaInscritoEm :CUR-0001 ;
    :historicoAprendizagem :REC-0002,
        :REC-0005 ;
    :idAprendiz "APR-0001" ;
    :nome "João Silva" ;
    rdfs:comment "Indivíduo Aprendiz 0001"@pt .

:COMP-0001 a :Competencia,
        owl:NamedIndividual ;
    :area "Programação de Computadores" ;
    :idCompetencia "COMP-0001" ;
    :nome "Classes e Objetos em POO" ;
    rdfs:comment "Indivíduo Competência 0001"@pt .

:temComponenteKSA a owl:ObjectProperty ;
    rdfs:label "tem componente KSA"@pt ;
    rdfs:domain :Competencia ;
    owl:inverseOf :ehComponenteKSADe .

:AVAL-0002 a :ObjetivasAval,
        owl:NamedIndividual ;
    :descricao "Avaliação focada no conceito de herança..." ;
    :idAvaliacao "AVAL-0002" ;
    :questoesIncluidas :QUEST-0003 ;
    :tipo "Objetiva" ;
    rdfs:comment "Indivíduo Avaliação 0002"@pt .

:COMP-0002 a :Competencia,
        owl:NamedIndividual ;
    :area "Programação de Computadores" ;
    :descricao "Capacidade de utilizar herança para reutilizar e estender o código..." ;
    :ehCompostoDeConhecimento :KNOW-001 ;
    :ehCompostoDeHabilidade :SKILL-001 ;
    :idCompetencia "COMP-0002" ;
    :nome "Herança em Python" ;
    :requer :COMP-0001 ;
    rdfs:comment "Indivíduo Competência 0002"@pt .

:UsuarioDoAva a owl:Class ;
    rdfs:label "Usuário do AVA"@pt ;
    rdfs:comment "Classe base para todos os usuários do sistema."@pt .

:ehComponenteKSADe a owl:ObjectProperty ;
    rdfs:label "é componente KSA de"@pt .

:Atitude a owl:Class ;
    rdfs:label "Atitude"@pt ;
    rdfs:comment "Saber comportamental."@pt .

:Conhecimento a owl:Class ;
    rdfs:label "Conhecimento"@pt ;
    rdfs:comment "Saber teórico."@pt ;
    owl:disjointWith :Atitude,
        :Habilidade .

:Habilidade a owl:Class ;
    rdfs:label "Habilidade"@pt ;
    rdfs:comment "Saber prático."@pt ;
    owl:disjointWith :Atitude .

:TrajetoriasDeAprendizagem a owl:Class ;
    rdfs:label "Trajetórias de Aprendizagem"@pt ;
    rdfs:comment "Caminho de aprendizagem."@pt .

:MilestoneDeAprendizagem a owl:Class ;
    rdfs:label "Milestone de Aprendizagem"@pt ;
    rdfs:comment "Marco de progresso."@pt .

:Avaliacao a owl:Class ;
    rdfs:label "Avaliação"@pt ;
    rdfs:comment "Instrumento de avaliação."@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :questoesIncluidas ;
            owl:someValuesFrom :Questao ] .

:Instrutor a owl:Class ;
    rdfs:label "Instrutor"@pt ;
    rdfs:comment "Professor ou tutor."@pt ;
    rdfs:subClassOf :UsuarioDoAva .

:Aprendiz a owl:Class ;
    rdfs:label "Aprendiz"@pt ;
    rdfs:comment "Estudante ou aluno."@pt ;
    rdfs:subClassOf :UsuarioDoAva ;
    owl:disjointWith :Instrutor .

:NiveisDeProficiencia a owl:Class ;
    rdfs:label "Níveis de Proficiência"@pt ;
    rdfs:comment "Escala de domínio."@pt .

:Curso a owl:Class ;
    rdfs:label "Curso"@pt ;
    rdfs:comment "Unidade de ensino."@pt .

:DesempenhoDoAprendiz a owl:Class ;
    rdfs:label "Desempenho do Aprendiz"@pt ;
    rdfs:comment "Registro de performance."@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :proficienciaAtingida ;
            owl:someValuesFrom :NiveisDeProficiencia ] .

:Questao a owl:Class ;
    rdfs:label "Questão"@pt ;
    rdfs:comment "Item de avaliação."@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :competenciasAvaliadas ;
            owl:someValuesFrom :Competencia ] .

:RecursoDeAprendizagem a owl:Class ;
    rdfs:label "Recurso de Aprendizagem"@pt ;
    rdfs:comment "Entidade que representa qualquer material, ferramenta ou conteúdo (digital ou não) utilizado para dar suporte ao processo de ensino e aprendizagem."@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :abordaCompetencia ;
            owl:someValuesFrom :Competencia ] .

:Competencia a owl:Class ;
    rdfs:label "Competência"@pt ;
    rdfs:comment "Conjunto de conhecimentos, habilidades e atitudes."@pt ;
    owl:disjointWith :RecursoDeAprendizagem .

[] a owl:AllDisjointClasses ;
    owl:members ( :UsuarioDoAva :Competencia :RecursoDeAprendizagem :DesempenhoDoAprendiz :Questao :Avaliacao :Curso :NiveisDeProficiencia :MilestoneDeAprendizagem :TrajetoriasDeAprendizagem :Conhecimento :Habilidade :Atitude ) .

