        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Pergunta da questão.</rdfs:comment>
        <rdfs:label xml:lang="pt">enunciado</rdfs:label>
    </owl:DatatypeProperty>
    


