        <ontologia:desempenhoCompetencias rdf:resource="http://www.ontolearn.com/ontologia#DEMP-0004"/>
        <ontologia:desempenhoCompetencias rdf:resource="http://www.ontolearn.com/ontologia#DEMP-0005"/>
        <ontologia:estaInscritoEm rdf:resource="http://www.ontolearn.com/ontologia#CUR-0001"/>
