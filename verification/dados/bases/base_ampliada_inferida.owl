     -->

    


    <!-- http://www.ontolearn.com/ontologia#alternativas -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#alternativas">
        <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Questao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Opções de resposta.</rdfs:comment>
        <rdfs:label xml:lang="pt">alternativas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#area -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#area">
        <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Área de conhecimento.</rdfs:comment>
        <rdfs:label xml:lang="pt">área</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#data -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#data">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#DesempenhoDoAprendiz"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#MilestoneDeAprendizagem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="pt">Data e hora do evento registrado: a conquista de um marco de aprendizagem ou a resposta de um registro de desempenho.</rdfs:comment>
        <rdfs:label xml:lang="pt">data</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#descricao -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#descricao">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Atitude"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Avaliacao"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Competencia"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Conhecimento"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Curso"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Habilidade"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#MilestoneDeAprendizagem"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Texto descritivo.</rdfs:comment>
        <rdfs:label xml:lang="pt">descrição</rdfs:label>
    </owl:DatatypeProperty>
    


