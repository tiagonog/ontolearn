        <ontologia:idAprendiz>APR-0001</ontologia:idAprendiz>
        <ontologia:nome>João Silva</ontologia:nome>
        <rdfs:comment xml:lang="pt">Indivíduo Aprendiz 0001</rdfs:comment>
    </owl:Thing>
    


