    <!-- http://www.ontolearn.com/ontologia#APR-0003 -->

    <owl:Thing rdf:about="http://www.ontolearn.com/ontologia#APR-0003">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
