    <!-- http://www.ontolearn.com/ontologia#nome -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#nome">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Competencia"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Curso"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#UsuarioDoAva"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Nome ou designação da entidade.</rdfs:comment>
        <rdfs:label xml:lang="pt">nome</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#respostaAprendiz -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#respostaAprendiz">
        <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#DesempenhoDoAprendiz"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Resposta fornecida pelo aluno.</rdfs:comment>
        <rdfs:label xml:lang="pt">resposta do aprendiz</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#respostaCorreta -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#respostaCorreta">
        <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Questao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Gabarito da questão.</rdfs:comment>
        <rdfs:label xml:lang="pt">resposta correta</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#tipo -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#tipo">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Avaliacao"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#MilestoneDeAprendizagem"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#Questao"/>
                    <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Categoria ou tipo do objeto.</rdfs:comment>
        <rdfs:label xml:lang="pt">tipo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#titulo -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#titulo">
        <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Curso"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="pt">Título do curso.</rdfs:comment>
        <rdfs:label xml:lang="pt">título</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ontolearn.com/ontologia#url -->

    <owl:DatatypeProperty rdf:about="http://www.ontolearn.com/ontologia#url">
        <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="pt">Endereço web do recurso.</rdfs:comment>
        <rdfs:label xml:lang="pt">URL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontolearn.com/ontologia#Analisar -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Analisar">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
        <rdfs:comment xml:lang="pt">Nível Analisar.</rdfs:comment>
        <rdfs:label xml:lang="pt">Analisar</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Aplicar -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Aplicar">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
        <rdfs:comment xml:lang="pt">Nível Aplicar.</rdfs:comment>
        <rdfs:label xml:lang="pt">Aplicar</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Aprendiz -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Aprendiz">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#UsuarioDoAva"/>
        <rdfs:comment xml:lang="pt">Estudante ou aluno.</rdfs:comment>
        <rdfs:label xml:lang="pt">Aprendiz</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Atitude -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Atitude">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:disjointWith rdf:resource="http://www.ontolearn.com/ontologia#Conhecimento"/>
        <owl:disjointWith rdf:resource="http://www.ontolearn.com/ontologia#Habilidade"/>
        <rdfs:comment xml:lang="pt">Componente atitudinal de uma competência (saber ser): disposições, valores e posturas que orientam a ação do aprendiz ao mobilizar conhecimentos e habilidades, como valorizar a legibilidade do código.</rdfs:comment>
        <rdfs:label xml:lang="pt">Atitude</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Avaliacao -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Avaliacao">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontolearn.com/ontologia#questoesIncluidas"/>
                <owl:someValuesFrom rdf:resource="http://www.ontolearn.com/ontologia#Questao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="pt">Instrumento aplicado em um curso para obter evidências da aprendizagem, como uma prova ou um questionário, composto por uma ou mais questões.</rdfs:comment>
        <rdfs:label xml:lang="pt">Avaliação</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#AvaliarBloom -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#AvaliarBloom">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
        <rdfs:comment xml:lang="pt">Nível Avaliar.</rdfs:comment>
        <rdfs:label xml:lang="pt">Avaliar (Bloom)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Competencia -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Competencia">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:disjointWith rdf:resource="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
        <rdfs:comment xml:lang="pt">Conjunto de conhecimentos, habilidades e atitudes.</rdfs:comment>
        <rdfs:label xml:lang="pt">Competência</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Conhecimento -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Conhecimento">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:disjointWith rdf:resource="http://www.ontolearn.com/ontologia#Habilidade"/>
        <rdfs:comment xml:lang="pt">Componente cognitivo de uma competência (saber): informações, fatos, conceitos e princípios de um domínio que o aprendiz precisa compreender, como a definição de superclasse e de subclasse.</rdfs:comment>
        <rdfs:label xml:lang="pt">Conhecimento</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Criar -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Criar">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
        <rdfs:comment xml:lang="pt">Nível Criar.</rdfs:comment>
        <rdfs:label xml:lang="pt">Criar</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Curso -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Curso">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="pt">Oferta formativa disponibilizada no AVA, com título, nível e descrição, na qual os aprendizes se inscrevem e à qual se vinculam os instrutores responsáveis, os recursos e as avaliações.</rdfs:comment>
        <rdfs:label xml:lang="pt">Curso</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#DesempenhoDoAprendiz -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#DesempenhoDoAprendiz">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontolearn.com/ontologia#proficienciaAtingida"/>
                <owl:someValuesFrom rdf:resource="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="pt">Registro da resposta de um aprendiz a uma questão, que associa o aprendiz avaliado, a questão respondida e o nível de proficiência atingido; é a unidade de evidência da qual se obtém o nível do aprendiz em cada competência.</rdfs:comment>
        <rdfs:label xml:lang="pt">Desempenho do Aprendiz</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Didatico -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Didatico">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
        <rdfs:comment xml:lang="pt">Material didático.</rdfs:comment>
        <rdfs:label xml:lang="pt">Didático</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Entender -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Entender">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
        <rdfs:comment xml:lang="pt">Nível Entender.</rdfs:comment>
        <rdfs:label xml:lang="pt">Entender</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Formativo -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Formativo">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#DesempenhoDoAprendiz"/>
        <rdfs:comment xml:lang="pt">Registro de desempenho obtido em uma avaliação de caráter formativo.</rdfs:comment>
        <rdfs:label xml:lang="pt">Formativo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Habilidade -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Habilidade">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="pt">Componente prático de uma competência (saber fazer): capacidade de aplicar conhecimentos para executar tarefas ou resolver problemas, como implementar uma subclasse que sobrescreve um método.</rdfs:comment>
        <rdfs:label xml:lang="pt">Habilidade</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Instrutor -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Instrutor">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#UsuarioDoAva"/>
        <rdfs:comment xml:lang="pt">Professor ou tutor.</rdfs:comment>
        <rdfs:label xml:lang="pt">Instrutor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Interativo -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Interativo">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
        <rdfs:comment xml:lang="pt">Material interativo.</rdfs:comment>
        <rdfs:label xml:lang="pt">Interativo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Lembrar -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Lembrar">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
        <rdfs:comment xml:lang="pt">Nível Lembrar.</rdfs:comment>
        <rdfs:label xml:lang="pt">Lembrar</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#MilestoneDeAprendizagem -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#MilestoneDeAprendizagem">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="pt">Marco de progresso conquistado por um aprendiz, como a conclusão de um curso ou de uma trilha, registrado com data e associado às competências cuja conquista ele atesta.</rdfs:comment>
        <rdfs:label xml:lang="pt">Milestone de Aprendizagem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Multimidia -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Multimidia">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
        <rdfs:comment xml:lang="pt">Material multimídia.</rdfs:comment>
        <rdfs:label xml:lang="pt">Multimídia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#NiveisDeProficiencia -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#NiveisDeProficiencia">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="pt">Nível de domínio demonstrado ou exigido em uma competência, na escala dos seis níveis do domínio cognitivo da Taxonomia de Bloom revisada (Lembrar, Entender, Aplicar, Analisar, Avaliar e Criar), representados pelas subclasses. Cada instância é um nível da escala.</rdfs:comment>
        <rdfs:label xml:lang="pt">Nível de Proficiência</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Objetiva -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Objetiva">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#Questao"/>
        <owl:disjointWith rdf:resource="http://www.ontolearn.com/ontologia#Subjetiva"/>
        <rdfs:comment xml:lang="pt">Questão de resposta fechada, com alternativas e resposta correta predefinidas.</rdfs:comment>
        <rdfs:label xml:lang="pt">Objetiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#ObjetivasAval -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#ObjetivasAval">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#Avaliacao"/>
        <rdfs:comment xml:lang="pt">Prova objetiva.</rdfs:comment>
        <rdfs:label xml:lang="pt">Avaliação Objetiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Questao -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Questao">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontolearn.com/ontologia#competenciasAvaliadas"/>
                <owl:someValuesFrom rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="pt">Item de avaliação.</rdfs:comment>
        <rdfs:label xml:lang="pt">Questão</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#RecursoDeAprendizagem -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="pt">Entidade que representa qualquer material, ferramenta ou conteúdo (digital ou não) utilizado para dar suporte ao processo de ensino e aprendizagem.</rdfs:comment>
        <rdfs:label xml:lang="pt">Recurso de Aprendizagem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Subjetiva -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Subjetiva">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#Questao"/>
        <rdfs:comment xml:lang="pt">Questão de resposta aberta, redigida pelo aprendiz, cuja correção depende de critérios de avaliação ou do julgamento do instrutor.</rdfs:comment>
        <rdfs:label xml:lang="pt">Subjetiva</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#TrajetoriasDeAprendizagem -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#TrajetoriasDeAprendizagem">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="pt">Percurso de aprendizagem realizado por um aprendiz, descrito por uma sequência ordenada de etapas e associado às competências que ele desenvolve.</rdfs:comment>
        <rdfs:label xml:lang="pt">Trajetória de Aprendizagem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#UsuarioDoAva -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#UsuarioDoAva">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="pt">Classe base para todos os usuários do sistema.</rdfs:comment>
        <rdfs:label xml:lang="pt">Usuário do AVA</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontolearn.com/ontologia#Video -->

    <owl:Class rdf:about="http://www.ontolearn.com/ontologia#Video">
        <rdfs:subClassOf rdf:resource="http://www.ontolearn.com/ontologia#Multimidia"/>
        <rdfs:comment xml:lang="pt">Conteúdo em vídeo.</rdfs:comment>
        <rdfs:label xml:lang="pt">Vídeo</rdfs:label>
    </owl:Class>
    


