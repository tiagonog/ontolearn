    <owl:inverseOf rdf:resource="http://www.ontolearn.com/ontologia#desempenhoCompetencias"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#competenciasEnvolvidas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Relaciona um marco ou uma trajetória de aprendizagem às competências a que se refere: no marco, as competências cuja conquista ele atesta; na trajetória, as competências que ela desenvolve.</rdfs:comment>
    <rdfs:domain rdf:nodeID="b20"/>
    <rdfs:label xml:lang="pt">competências envolvidas</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <owl:inverseOf rdf:resource="http://www.ontolearn.com/ontologia#ehEnvolvidaEm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#compoeAtitudeEm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Competência da qual a atitude faz parte.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Atitude"/>
    <rdfs:label xml:lang="pt">compõe (atitude)</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontolearn.com/ontologia#ehComponenteKSADe"/>
    <owl:inverseOf rdf:resource="http://www.ontolearn.com/ontologia#ehCompostoDeAtitude"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#compoeConhecimentoEm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Competência da qual o conhecimento faz parte.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Conhecimento"/>
    <rdfs:label xml:lang="pt">compõe (conhecimento)</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontolearn.com/ontologia#ehComponenteKSADe"/>
    <owl:inverseOf rdf:resource="http://www.ontolearn.com/ontologia#ehCompostoDeConhecimento"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#compoeHabilidadeEm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Competência da qual a habilidade faz parte.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Habilidade"/>
    <rdfs:label xml:lang="pt">compõe (habilidade)</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontolearn.com/ontologia#ehComponenteKSADe"/>
    <owl:inverseOf rdf:resource="http://www.ontolearn.com/ontologia#ehCompostoDeHabilidade"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#conquistasAdquiridas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Marcos alcançados pelo estudante.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Aprendiz"/>
    <rdfs:label xml:lang="pt">conquistas adquiridas</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#MilestoneDeAprendizagem"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#data">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="pt">Data e hora do evento registrado: a conquista de um marco de aprendizagem ou a resposta de um registro de desempenho.</rdfs:comment>
    <rdfs:domain rdf:nodeID="b19"/>
    <rdfs:label xml:lang="pt">data</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#descricao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="pt">Texto descritivo.</rdfs:comment>
    <rdfs:domain rdf:nodeID="b27"/>
    <rdfs:label xml:lang="pt">descrição</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#desempenhoCompetencias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Relaciona o aprendiz a cada registro de desempenho que documenta uma de suas respostas. A relação aponta para o registro, e não para a competência: as competências evidenciadas são obtidas pela questão respondida e pelas competências que ela avalia.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Aprendiz"/>
    <rdfs:label xml:lang="pt">registros de desempenho</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#DesempenhoDoAprendiz"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#ehAbordadaPor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Indica quais recursos educacionais cobrem esta competência.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:label xml:lang="pt">é abordada por</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#RecursoDeAprendizagem"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#ehComponenteKSADe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Relaciona um componente CHA (conhecimento, habilidade ou atitude) à competência que ele compõe; inversa de temComponenteKSA, generaliza compoeConhecimentoEm, compoeHabilidadeEm e compoeAtitudeEm.</rdfs:comment>
    <rdfs:domain rdf:nodeID="b54"/>
    <rdfs:label xml:lang="pt">é componente KSA de</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#ehCompostoDeAtitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Atitudes que compõem a competência.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:label xml:lang="pt">é composto de atitude</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Atitude"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontolearn.com/ontologia#temComponenteKSA"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#ehCompostoDeConhecimento">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Conhecimentos teóricos que compõem a competência.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:label xml:lang="pt">é composto de conhecimento</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Conhecimento"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontolearn.com/ontologia#temComponenteKSA"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#ehCompostoDeHabilidade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Habilidades práticas que compõem a competência.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:label xml:lang="pt">é composto de habilidade</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Habilidade"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontolearn.com/ontologia#temComponenteKSA"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#ehEnvolvidaEm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Milestones ou trajetórias que envolvem a competência.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:label xml:lang="pt">é envolvida em</rdfs:label>
    <rdfs:range rdf:nodeID="b33"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#ehExigidoPor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="pt">Questões que exigem este nível.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#NiveisDeProficiencia"/>
    <rdfs:label xml:lang="pt">é exigido por</rdfs:label>
    <rdfs:range rdf:resource="http://www.ontolearn.com/ontologia#Questao"/>
    <owl:inverseOf rdf:resource="http://www.ontolearn.com/ontologia#exigeNivel"/>
