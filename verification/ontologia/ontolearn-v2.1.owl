  <rdf:Description rdf:about="http://www.ontolearn.com/ontologia#ehRequeridaPor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:comment xml:lang="pt">Competências que exigem esta como pré-requisito.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.ontolearn.com/ontologia#Competencia"/>
    <rdfs:label xml:lang="pt">é requerida por</rdfs:label>
